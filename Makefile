# =============================================================================
# Makefile для проекта Passman
# =============================================================================
#
# Что такое Makefile?
# -------------------
# Makefile — это файл с инструкциями для утилиты make.
# Make позволяет запускать часто используемые команды через короткие алиасы.
#
# Как это работает:
# 1. Вы пишете в терминале: make build
# 2. Make читает этот файл, находит цель (target) "build"
# 3. Выполняет все команды, перечисленные под ней
#
# Структура цели:
#   имя_цели:                    # Название, которое вы пишете после "make"
#   @echo "Текст"                # @ — не показывать саму команду, только результат
#   go build -o passman ./cmd/passman  # Команда, которая выполняется
#
# ПЕРЕМЕННЫЕ
# ----------
# Переменные объявляются как VAR = значение
# Используются как $(VAR)
# Это позволяет не дублировать пути и флаги
# =============================================================================

# --- Переменные ------------------------------------------------------------
# BINARY_NAME — имя итогового бинарного файла
BINARY_NAME = passman

# GO — интерпретатор Go
GO = go

# DIR — директория с исходным кодом
DIR = ./cmd/passman

# --- Цели (targets) --------------------------------------------------------
# .PHONY — объявляет цели, которые НЕ являются файлами.
# Это важно: без этого make подумает, что если файл "build" существует,
# то цель уже выполнена и ничего делать не будет.

.PHONY: help build test clean run vet

# --- Цель: help ------------------------------------------------------------
# Это "главная" цель — вызывается по умолчанию, если просто написать "make"
# Выводит справку по всем доступным командам
help:
	@echo "Passman — доступные команды:"
	@echo ""
	@echo "  make build    — Собрать бинарный файл"
	@echo "  make test     — Запустить все тесты"
	@echo "  make clean    — Удалить скомпилированные файлы"
	@echo "  make run      — Собрать и запустить"
	@echo "  make vet      — Проверить код через go vet"
	@echo ""
	@echo "Примеры:"
	@echo "  make build    # собрать бинарник"
	@echo "  make test     # запустить тесты"

# --- Цель: build -----------------------------------------------------------
# Собирает бинарный файл из исходного кода
# -o $(BINARY_NAME) — имя выходного файла (passman)
# $(DIR) — директория с main.go
build:
	@echo "Сборка проекта..."
	$(GO) build -o $(BINARY_NAME) $(DIR)
	@echo "Готово: ./$(BINARY_NAME)"

# --- Цель: test ------------------------------------------------------------
# Запускает все тесты в проекте
# ./... — все пакеты рекурсивно
# -v — подробный вывод (verbose)
test:
	@echo "Запуск тестов..."
	$(GO) test ./... -v

# --- Цель: vet -------------------------------------------------------------
# Статический анализатор Go — ищет потенциальные баги
# go vet — аналог линтера для Go, проверяет синтаксис и семантику
vet:
	@echo "Проверка кода через go vet..."
	$(GO) vet ./...

# --- Цель: clean -----------------------------------------------------------
# Удаляет скомпилированные файлы
# rm -f — удаляет файл, не выдаёт ошибку если его нет
clean:
	@echo "Очистка..."
	rm -f $(BINARY_NAME)
	@echo "Готово"

# --- Цель: run -------------------------------------------------------------
# Собирает и сразу запускает проект
# ARGS — переменная, которую можно передать из командной строки
# Пример: make run ARGS="help"
run: build
	@echo "Запуск..."
	./$(BINARY_NAME) $(ARGS)